# NanoClaw daemon env template. Copy to nanoclaw/.env and fill in real values.
#
# The daemon runs on the shared studentclaw VM (one process, all students).
# It hosts:
#   - Discord gateway adapter (the Studentclaw bot)
#   - Control plane HTTP server on WEBHOOK_PORT (ChatCSE backend calls in
#     /api/agent-groups/wirings + /api/dm/welcome over this)
#   - Spawns per-student Docker containers running the claude-agent-sdk

# ── Discord ──────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# From the same page → General Information → Public Key
DISCORD_PUBLIC_KEY=

# ── LLM provider for per-student agent runtime ───────────────────
# The claude-agent-sdk reads this directly inside the container.
ANTHROPIC_API_KEY=sk-ant-...

# ── Control plane (must match ChatCSE backend's NANOCLAW_CONTROL_TOKEN) ──
# Shared bearer between this daemon and the ChatCSE backend. Generate:
#   openssl rand -hex 32
NANOCLAW_CONTROL_TOKEN=

# ── Optional ─────────────────────────────────────────────────────
# Local HTTP port the control plane binds to. Default 3000 collides with
# Next.js in local dev, so we use 3100. Prod can use 3000 (or anything).
WEBHOOK_PORT=3100

# Used in OneCLI integration (only matters if you're routing through it).
ONECLI_URL=http://127.0.0.1:10254

# Display fields shown in the bot's outbound messages.
ASSISTANT_NAME=Studentclaw
TZ=America/Los_Angeles
